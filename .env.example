# Leave both unset for local dev - the app falls back to a local file-based
# libSQL database at data/alba-content-hub.db, no account needed.
#
# Set both when running against a real Turso database (required on Vercel,
# since its filesystem is ephemeral and can't hold a local db file):
#   1. brew install tursodatabase/tap/turso   (or see https://docs.turso.tech/cli/installation)
#   2. turso auth signup   (or: turso auth login)
#   3. turso db create alba-content-hub
#   4. turso db show alba-content-hub --url          -> TURSO_DATABASE_URL
#   5. turso db tokens create alba-content-hub        -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# scrape-worker: вторая база заказчиков (ScrapeGraphAI на локальной Ollama).
# Поднимается отдельным стеком, см. scrape-worker/README.md. Без этих
# переменных вкладка «ScrapeGraph» в «Заказчиках» честно скажет, что воркер
# не настроен, а всё остальное продолжит работать.
SCRAPE_WORKER_URL=
SCRAPE_WORKER_TOKEN=

# Lets the Generator/Researcher/Insights Claude routines (see
# docs/insights-agent-routine.md) call the hub's /api/* routes once
# ADMIN_EMAIL/ADMIN_PASSWORD_HASH/SESSION_SECRET lock it down for everyone
# else - they have no browser session cookie to authenticate with. Generate
# with `openssl rand -hex 32`, set it here, and configure each routine to
# send `Authorization: Bearer <this value>`. Leave unset to disable this
# bypass entirely (routines will get 401s, same as any other caller without
# a session).
AGENT_API_TOKEN=
