{
  "buildCommand": "node scripts/prefetch-embedding-model.mjs && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/models/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/agent-researcher/run", "schedule": "30 5 * * *" }
  ]
}
